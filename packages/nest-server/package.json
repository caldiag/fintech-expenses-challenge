{
  "name": "@app/nest-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "pnpm run start:dev",
    "build": "pnpm --filter @app/types build && nest build",
    "deploy": "nest deploy",
    "gen-migrations": "sh -c 'if [ -z \"$1\" ]; then printf \"%s\\n\" \"Usage: pnpm gen-migrations <name>\" >&2; exit 1; fi; pnpm typeorm-ts-node-esm migration:generate -d src/typeorm/datasource.ts \"./src/typeorm/migrations/$1\"' --",
    "run-migrations": "pnpm typeorm-ts-node-esm migration:run -d src/typeorm/datasource.ts",
    "reset-db": "sh -c 'found=; for file in src/typeorm/migrations/*.ts src/typeorm/migrations/*.js; do if [ -f \"$file\" ]; then found=1; break; fi; done; if [ -z \"$found\" ]; then printf \"%s\\n\" \"No migrations found; refusing to reset database.\" >&2; exit 1; fi; pnpm typeorm-ts-node-esm schema:drop -d src/typeorm/datasource.ts && pnpm typeorm-ts-node-esm migration:run -d src/typeorm/datasource.ts'",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "pnpm --filter @app/types build && nest start",
    "start:dev": "pnpm --filter @app/types build && nest start --watch",
    "start:debug": "pnpm --filter @app/types build && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@app/types": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.3",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
