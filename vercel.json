{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "nest-server": {
      "root": "packages/nest-server",
      "framework": "nestjs",
      "entrypoint": "src/main.ts",
      "outputDirectory": ".",
      "installCommand": "npx --yes pnpm@12.18.0 install --frozen-lockfile",
      "buildCommand": "npx --yes pnpm@12.18.0 --filter @app/nest-server build"
    },
    "react-client": {
      "root": "packages/react-client",
      "framework": "react-router",
      "installCommand": "npx --yes pnpm@12.18.0 install --frozen-lockfile",
      "buildCommand": "npx --yes pnpm@12.18.0 --filter @app/react-client build"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "nest-server" } },
    { "source": "/", "destination": { "service": "react-client", "path": "/index.html" } },
    { "source": "/:path*", "destination": { "service": "react-client" } }
  ]
}
